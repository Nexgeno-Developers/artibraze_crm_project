# Ignore .htaccess
/.htaccess
/.htaccess.*

# Ignore upload directories
/uploads/
/modules/*/uploads/

# Ignore CI session files
ci_sessions/
/ci_sessions/

/application/vendor/
!/modules/*/vendor/

# Ignore all .lock and .zip files
*.lock
*.zip
*.xlsx
*.xls
*.sql
!/backups/*.sql

error_log
/application/logs

/application/config/app-config.php
/application/cache/*

/install123/

# Local KPI module notes (not for repo)
modules/kpi_management/KPI_RECONCILE_GUIDE.txt

# Agents
.agents/*

# User-uploaded media (keep only the index.html guard files that are tracked)
/media/**
!/media/**/
!/media/**/index.html

# Server-only files created by cPanel / webhost (never deploy these)
/.well-known/
*.bak
*.bak.*
/cgi-bin/

# Windows folder settings
desktop.ini
